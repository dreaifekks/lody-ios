      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄照片并添加到消息附件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos to attach to your messages."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接局域网中的 Mac，查看和控制其 iOS 模拟器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your Mac on the local network to view and control its iOS Simulator."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于听写消息。语音在本机转换为文字，录音不会被保存或上传。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate messages. Your voice is turned into text on this device, and the recording is not saved or uploaded."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片作为消息附件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos to attach to your messages."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你听写的内容转为消息文字。识别在本机完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn what you dictate into message text. Recognition runs on this device."
          }
        }
      }
    }
  },
  "version": "1.0"
