    "schedules.emptyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a prompt and a time. Your machine will start a new chat for each run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置要做的事和运行时间，你的机器会在每次运行时创建新会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇提示詞與時間，你的電腦會在每次執行時開啟新對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
