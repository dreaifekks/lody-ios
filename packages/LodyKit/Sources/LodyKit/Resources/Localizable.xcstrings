    "send.error.mcpCatalog": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 MCP 设置，请恢复连接后重新发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load MCP settings. Refresh the connection and try sending again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入 MCP 設定。請重新整理連線後再傳送一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP設定を読み込めませんでした。接続を更新してから再度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 설정을 불러오지 못했습니다. 연결을 새로고침한 후 다시 전송해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la configuración de MCP. Actualiza la conexión e intenta enviar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les réglages MCP. Actualisez la connexion et essayez de renvoyer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить настройки MCP. Обновите подключение и попробуйте отправить снова."
          }
        }
      }
    },
    "send.error.mcpConnection": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 MCP 服务器尚无有效连接，请在电脑上的 Lody 中补充连接，或在设置中删除该服务器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected MCP server has no valid connection. Configure it in Lody on your computer, or delete that server in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的 MCP 伺服器沒有有效連線。請在電腦上的 Lody 中進行設定，或在「設定」中刪除該伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したMCPサーバーに有効な接続がありません。パソコンのLodyで設定するか、設定からそのサーバーを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 MCP 서버에 유효한 연결이 없습니다. 컴퓨터의 Lody에서 설정하거나 설정에서 해당 서버를 삭제하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno de los servidores MCP seleccionados no tiene una conexión válida. Configúralo en Lody en tu equipo o elimina ese servidor en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur MCP sélectionné n’a pas de connexion valide. Configurez-le dans Lody sur votre ordinateur ou supprimez ce serveur dans les Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У выбранного сервера MCP нет действующего подключения. Настройте его в Lody на компьютере или удалите этот сервер в Настройках."
          }
        }
      }
    },
