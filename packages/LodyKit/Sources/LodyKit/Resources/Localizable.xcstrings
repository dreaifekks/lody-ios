    "settings.roles.hintShort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mention a Role with @ in the composer to start a chat with it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框中用 @ 提及角色，即可用它开始对话。"
