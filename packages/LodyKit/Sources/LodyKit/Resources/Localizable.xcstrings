    "debug.native.faultExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fault injection temporarily interrupts synchronization. The watchdog should rebuild automatically; after repeated failures reach the limit, return to the project page and pull to resync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故障注入会暂时中断同步。看门狗应自动重建；连续故障达到上限后，请返回项目页下拉重新同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤注入會暫時中斷同步。監控機制應會自動重建；若連續失敗達到上限，請返回專案頁面並下拉重新同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォールトインジェクションは同期を一時的に中断します。ウォッチドッグが自動で再構築しますが、失敗が上限回数に達した場合はプロジェクトページに戻ってプルして再同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류 주입은 동기화를 일시적으로 중단합니다. 워치독이 자동으로 복구를 시도하며, 반복 실패가 한도에 도달하면 프로젝트 페이지로 돌아가 아래로 당겨 다시 동기화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inyección de fallos interrumpe temporalmente la sincronización. El monitor debería reconstruirse automáticamente; si los fallos repetidos alcanzan el límite, vuelve a la página del proyecto y desliza hacia abajo para resincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'injection de pannes interrompt temporairement la synchronisation. Le watchdog devrait se reconstruire automatiquement ; une fois la limite d'échecs répétés atteinte, revenez à la page du projet et tirez pour resynchroniser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитация сбоя временно прерывает синхронизацию. Сторожевой механизм должен выполнить пересборку автоматически; если число повторных сбоев достигнет лимита, вернитесь на страницу проекта и потяните вниз для повторной синхронизации."
          }
        }
      }
    },
