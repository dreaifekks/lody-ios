    "diagnostics.confirmHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的诊断记录将被删除。已经分享的文件不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics on this iPhone are deleted. Files you already shared are not affected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 iPhone 上的診斷資料將會被刪除，先前已分享的檔案不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhone上の診断データが削除されます。すでに共有済みのファイルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 저장된 진단 기록이 삭제됩니다. 이미 공유한 파일에는 영향을 주지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el diagnóstico en este iPhone. Los archivos que ya compartiste no se verán afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diagnostics sur cet iPhone seront supprimés. Les fichiers déjà partagés ne sont pas affectés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные диагностики на этом iPhone будут удалены. Уже отправленные файлы останутся без изменений."
          }
        }
      }
    },
