    "bar.prompt.createPr": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前 worktree 创建 PR（非草稿）。`gh` 使用本机保存的 GitHub 登录，沙箱内的命令通常读不到。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a PR (not a draft) for the current worktree. `gh` uses the GitHub login saved on this machine, which sandboxed commands usually cannot read."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為目前的 worktree 建立 PR（非草稿）。`gh` 會使用儲存在本機的 GitHub 登入狀態，沙盒環境中的指令通常無法讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のワークツリーのPR（ドラフトではない通常のPR）を作成してください。`gh`はこのマシンに保存されたGitHubログイン情報を使用しますが、サンドボックス化されたコマンドからは通常読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 워크트리에 대한 PR(초안 아님)을 만드세요. `gh`는 이 머신에 저장된 GitHub 로그인 정보를 사용하며, 샌드박스 명령은 보통 이 정보를 읽을 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un PR (no en borrador) para el árbol de trabajo actual. `gh` usa la sesión de GitHub guardada en este equipo, que los comandos en sandbox normalmente no pueden leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une PR (pas un brouillon) pour le worktree actuel. `gh` utilise l’identifiant GitHub enregistré sur cette machine, que les commandes en bac à sable ne peuvent généralement pas lire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте PR (не черновик) для текущего worktree. `gh` использует логин GitHub, сохранённый на этом компьютере, к которому команды в песочнице обычно не имеют доступа."
          }
        }
      }
    },
    "bar.prompt.createDraftPr": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前 worktree 创建草稿 PR。`gh` 使用本机保存的 GitHub 登录，沙箱内的命令通常读不到。"
