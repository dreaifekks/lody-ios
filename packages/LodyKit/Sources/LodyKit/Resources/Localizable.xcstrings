      }
    },
    "native.chat.error.retryUnknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认是否送达，请等待会话同步后再操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery is unconfirmed. Wait for the session to sync before sending again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未確認是否送達，請等待對話同步後再重新傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信を確認できませんでした。セッションの同期が完了するまで待ってから再送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달 여부가 확인되지 않았습니다. 다시 보내기 전에 세션이 동기화될 때까지 기다리세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrega no está confirmada. Espera a que la sesión se sincronice antes de volver a enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi n’est pas confirmé. Attendez la synchronisation de la session avant de renvoyer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставка не подтверждена. Дождитесь синхронизации сессии перед повторной отправкой."
          }
        }
      }
    },
