          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回実行時に作成され、以降は同じチャットに続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 실행 시 생성되며, 이후 모든 실행은 이 채팅에서 이어집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea en la primera ejecución; todas las siguientes continúan en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créée lors de la première exécution ; chaque exécution suivante la poursuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся при первом запуске; каждый следующий запуск продолжает этот чат."
          }
        }
      }
    },
