    "schedules.error.schedule_conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule changed elsewhere. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时任务已在别处修改，请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此排程已在其他位置變更，請重新整理後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールが別の場所で変更されました。更新してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약이 다른 곳에서 변경되었습니다. 새로 고침한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La programación cambió en otro lugar. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La planification a été modifiée ailleurs. Actualisez et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расписание было изменено в другом месте. Обновите данные и повторите попытку."
          }
        }
      }
    },
    "schedules.error.schedule_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the computer, Agent and project, then save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查机器、Agent 和项目，然后重新保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查電腦、Agent 與專案，然後重新儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューター、エージェント、プロジェクトを確認してから、もう一度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터, 에이전트 및 프로젝트를 확인한 후 다시 저장하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la computadora, el Agente y el proyecto, y vuelve a guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’ordinateur, l’Agent et le projet, puis enregistrez à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте компьютер, агента и проект, затем сохраните снова."
          }
        }
      }
    },
    "schedules.error.schedule_write_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change may or may not have been applied. Check the schedule before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认修改是否已生效。请先检查定时任务再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認變更是否已套用。請先檢查排程再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更が適用されたかどうかを確認できませんでした。スケジュールを確認してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 적용되었는지 확인할 수 없습니다. 예약을 확인한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el cambio se haya aplicado o no. Revisa la programación antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification a peut-être été appliquée. Vérifiez la planification avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестно, применились ли изменения. Проверьте расписание перед повторной попыткой."
          }
        }
      }
    },
    "schedules.error.metadata_not_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for your workspace to finish syncing, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待工作区同步完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待工作區同步完成後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースの同期が完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
