    "send.reason.awaitingConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作结果待确认，请等待同步，不要重复发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is unconfirmed. Wait for sync instead of sending again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果尚未確認，請等待同步，不要重複傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が未確認です。再送信せず、同期が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 아직 확인되지 않았습니다. 다시 보내지 말고 동기화를 기다려 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado no está confirmado. Espera a que se sincronice en lugar de volver a enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat n’est pas confirmé. Attendez la synchronisation plutôt que d’envoyer à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат не подтверждён. Дождитесь синхронизации вместо повторной отправки."
          }
        }
      }
    },
