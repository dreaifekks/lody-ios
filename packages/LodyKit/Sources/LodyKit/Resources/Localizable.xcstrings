    "settings.usage.sharedShort": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额度来自这台机器的订阅，不是工作区账单。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quotas are this machine’s subscriptions, not workspace billing."
          }
