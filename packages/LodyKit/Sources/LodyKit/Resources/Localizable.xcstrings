    "native.chat.proposal.role.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to future uses of this Role. Existing sessions keep their configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅影响之后使用此 Role 的对话，已有对话保持原配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅套用於之後使用此 Role 的工作階段，現有工作階段將維持原有設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このロールの今後の使用に適用されます。既存のセッションは現在の設定を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 이 역할을 사용할 때부터 적용됩니다. 기존 세션은 현재 구성을 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a los próximos usos de este rol. Las sesiones existentes conservan su configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux prochaines utilisations de ce rôle. Les sessions existantes conservent leur configuration."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к будущим запускам этой роли. Текущие сессии сохранят свои настройки."
          }
        }
      }
    },
    "native.chat.proposal.role.ownerOnly": {
      "extractionState": "manual",
      "localizations": {
