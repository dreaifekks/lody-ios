    "settings.providers.codexCredentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials stay on the selected machine. For Custom API, enter the key during sign-in. Create a new provider to change authentication mode or destination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭证保留在所选电脑。自定义 API 的密钥在登录时输入。要更改认证方式或目标地址，请新建提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證會保留在所選主機上。若使用「自訂 API」，請在登入時輸入金鑰。若要更改驗證模式或目標位址，請建立新的提供者。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報は選択したマシンに保存されます。カスタムAPIの場合は、サインイン時にキーを入力してください。認証モードや接続先を変更するには、新しいプロバイダーを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명은 선택한 기기에만 저장됩니다. 사용자 지정 API의 경우 로그인 시 키를 입력하세요. 인증 모드나 대상을 변경하려면 새 프로바이더를 만드세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales permanecen en el equipo seleccionado. Para API personalizada, ingresa la clave al iniciar sesión. Crea un nuevo proveedor para cambiar el modo o destino de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants restent sur la machine sélectionnée. Pour une API personnalisée, saisissez la clé lors de la connexion. Créez un nouveau fournisseur pour changer le mode ou la destination d’authentification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётные данные остаются на выбранной машине. Для режима «Свой API» введите ключ во время входа. Чтобы изменить способ аутентификации или назначение, создайте нового провайдера."
          }
        }
      }
    },
