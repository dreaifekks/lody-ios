    "settings.providers.sorbetUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorbet connections and endpoint storage cannot be edited here because the native encrypted settings transport is not available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生加密设置传输暂不可用，无法在此编辑 Sorbet 连接和端点存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於原生加密設定傳輸功能無法使用，因此無法在此編輯 Sorbet 連線與端點儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブの暗号化設定トランスポートが利用できないため、Sorbet接続とエンドポイントの保存設定はここでは編集できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 암호화 설정 전송을 사용할 수 없어 여기에서 Sorbet 연결 및 엔드포인트 저장소를 편집할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones de Sorbet y el almacenamiento de endpoints no se pueden editar aquí porque el transporte nativo de configuración cifrada no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions Sorbet et le stockage des points de terminaison ne peuvent pas être modifiés ici car le transport natif chiffré des réglages n’est pas disponible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключения Sorbet и хранилище конечных точек здесь нельзя редактировать, так как нативный зашифрованный транспорт настроек недоступен."
          }
        }
      }
    },
