    "settings.shortcuts.slugHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 1–40 个小写字母、数字或连字符。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–40 lowercase letters, digits or hyphens."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 1–40 個小寫英文字母、數字或連字號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜40文字の半角英小文字、数字、ハイフンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~40자의 영문 소문자, 숫자 또는 하이픈(-)을 사용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa entre 1 y 40 letras minúsculas, dígitos o guiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1 à 40 lettres minuscules, chiffres ou traits d’union."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте 1–40 строчных букв, цифр или дефисов."
          }
        }
      }
    },
    "settings.shortcuts.visibilityHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建时选择可见性。iOS 保留已有模板的可见性。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose visibility when creating. Existing visibility is preserved on iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立時可選擇可見範圍。iOS 會保留現有的可見設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成時に公開範囲を選択してください。既存の公開範囲はiOSでは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성할 때 공개 범위를 선택하세요. iOS에서는 기존 공개 범위가 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la visibilidad al crear. La visibilidad existente se conserva en iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la visibilité lors de la création. La visibilité existante est conservée sur iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите видимость при создании. На iOS существующая видимость не изменяется."
          }
        }
      }
    },
    "settings.shortcuts.uncertain": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定本次保存内容以便安全重试。取消并重新打开后可再次编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save is held unchanged for a safe manual retry. Cancel and reopen to start another edit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留此次儲存內容以便安全手動重試。若要重新編輯，請取消並重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に再試行できるよう、今回の保存内容は変更せず保持されています。別の編集を始めるには、キャンセルして開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 수동 재시도를 위해 이 저장 내용이 변경되지 않은 채 보류 중입니다. 다른 편집을 시작하려면 취소 후 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
