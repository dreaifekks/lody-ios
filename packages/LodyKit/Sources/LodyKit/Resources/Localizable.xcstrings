    "pr.error.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有权限，或 GitHub 暂时限制了请求。请检查仓库授权后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission denied or GitHub temporarily limited the request. Check repository authorization and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限不足，或 GitHub 暫時限制了請求。請檢查儲存庫授權後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権がないか、GitHub によりリクエストが一時的に制限されています。リポジトリの権限を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없거나 GitHub에서 일시적으로 요청을 제한했습니다. 저장소 권한을 확인한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso denegado o GitHub limitó temporalmente la solicitud. Revisa la autorización del repositorio y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation refusée ou requête temporairement limitée par GitHub. Vérifiez les autorisations du dépôt et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ запрещён или GitHub временно ограничил запросы. Проверьте доступ к репозиторию и повторите попытку."
          }
        }
      }
    },
