    "session.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除「%1$@」并将其从会话列表中移除？删除后将无法在 Lody 中查看这段对话，且无法在应用内撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%1$@” and remove it from your session list? Its conversation will no longer be available in Lody. This cannot be undone in the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除「%1$@」並將它從工作階段列表中移除嗎？刪除後將無法再於 Lody 中查看這段對話，且無法在 App 內復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を削除してセッション一覧から取り除きますか？この会話はLodyで利用できなくなります。アプリ内では元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”을(를) 삭제하고 세션 목록에서 제거할까요? Lody에서 대화 내용을 더 이상 볼 수 없으며, 앱에서 되돌릴 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%1$@” y quitarla de tu lista de sesiones? Su conversación dejará de estar disponible en Lody. Esto no se puede deshacer en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %1$@ » et la retirer de votre liste de sessions ? Sa conversation ne sera plus disponible dans Lody. Cette action est irréversible dans l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@» и убрать из списка сессий? Переписка больше не будет доступна в Lody. Это действие нельзя отменить в приложении."
          }
        }
      },
      "comment": "1: title"
    },
    "session.delete.withTabs": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除「%2$@」及其 %1$@ 个子标签页？删除后将无法在 Lody 中查看这些对话，且无法在应用内撤销。另行开启的独立会话会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%2$@” and its %1$@ child tabs? Their conversations will no longer be available in Lody. Separately opened sessions are kept. This cannot be undone in the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除「%2$@」及其 %1$@ 個子分頁嗎？刪除後將無法再於 Lody 中查看這些對話，但另行開啟的工作階段將會保留。此操作無法在 App 內復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%2$@」とその%1$@個の子タブを削除しますか？これらの会話はLodyで利用できなくなります。個別に開いたセッションは保持されます。アプリ内では元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”과(와) 하위 탭 %1$@개를 삭제할까요? Lody에서 해당 대화 내용을 더 이상 볼 수 없습니다. 별도로 연 세션은 유지됩니다. 앱에서 되돌릴 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%2$@” y sus %1$@ pestañas secundarias? Sus conversaciones dejarán de estar disponibles en Lody. Las sesiones abiertas por separado se conservan. Esto no se puede deshacer en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %2$@ » et ses %1$@ onglets enfants ? Leurs conversations ne seront plus disponibles dans Lody. Les sessions ouvertes séparément sont conservées. Cette action est irréversible dans l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%2$@» и её дочерние вкладки (%1$@)? Их переписки больше не будут доступны в Lody. Отдельно открытые сессии сохранятся. Это действие нельзя отменить в приложении."
          }
        }
      },
      "comment": "1: count; 2: title"
    },
    "session.delete.busy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先停止此会话及正在运行的子标签页，再进行删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop this session and any running child tabs before deleting them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先停止此工作階段及所有執行中的子分頁，再進行刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除する前に、このセッションと実行中の子タブを停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하기 전에 이 세션과 실행 중인 모든 하위 탭을 중지하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén esta sesión y cualquier pestaña secundaria en ejecución antes de eliminarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez cette session et tout onglet enfant en cours avant de les supprimer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановите эту сессию и все запущенные дочерние вкладки перед удалением."
          }
        }
      }
    },
    "session.delete.worktree": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此会话使用独立工作树，对应目录也会从运行机器上移除。请先保存需要保留的改动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this session uses a separate worktree, its directory will also be removed from the machine. Save any changes you need first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此工作階段使用獨立的 worktree，對應的目錄也會從電腦上移除。請先儲存所需的變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションが別のworktreeを使用している場合、そのディレクトリもマシンから削除されます。必要な変更は先に保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션이 별도의 worktree를 사용하는 경우 머신에서 해당 디렉터리도 함께 삭제됩니다. 필요한 변경 사항은 먼저 저장하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta sesión usa un worktree separado, su directorio también se eliminará de la máquina. Guarda primero cualquier cambio que necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette session utilise un worktree séparé, son répertoire sera également supprimé de la machine. Enregistrez d’abord les modifications dont vous avez besoin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если эта сессия использует отдельный worktree, его каталог также будет удалён с машины. Сначала сохраните нужные изменения."
          }
        }
      }
    },
