    "home.onboarding.desktopHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the desktop app and sign in — it starts the agent runtime automatically."
          }
        },
        "zh-Hans": {
