    "onboarding.sessions.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何地方了解电脑上的助手正在做什么。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what the assistant on your Mac is doing, wherever you are."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論身在何處，都能掌握 Mac 上助理的執行進度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにいても、Mac上のアシスタントが何をしているか確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 Mac의 어시스턴트가 무엇을 하고 있는지 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira lo que está haciendo el asistente en tu Mac, estés donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que fait l’assistant sur votre Mac, où que vous soyez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наблюдайте за работой ассистента на вашем Mac, где бы вы ни находились."
          }
        }
      }
    },
