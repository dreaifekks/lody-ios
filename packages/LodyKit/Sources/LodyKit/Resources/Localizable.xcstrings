    "settings.providers.credentialWriteOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the key blank to keep the existing credential. Values are never loaded from the machine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥留空以保留已有凭证。不会从电脑读取密钥值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要保留現有憑證，請將金鑰留空。系統不會從主機載入憑證值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の認証情報を保持する場合は、キーを空欄のままにしてください。値がマシンから読み込まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 자격 증명을 유지하려면 키를 비워 두세요. 기기에서 값을 불러오지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la clave en blanco para conservar la credencial existente. Los valores nunca se cargan desde el equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez la clé vide pour conserver l’identifiant existant. Les valeurs ne sont jamais chargées depuis la machine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте поле ключа пустым, чтобы сохранить текущие учётные данные. Значения никогда не загружаются с машины."
          }
        }
      }
    },
