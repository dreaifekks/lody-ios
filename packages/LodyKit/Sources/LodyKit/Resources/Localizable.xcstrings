    "send.forget.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the local pending message. The computer may still receive or process it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除本地待确认消息，电脑仍可能收到或处理该消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除本機待確認的訊息，電腦端仍可能收到或處理該訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末上の保留中のメッセージを削除します。パソコン側ではすでに受信または処理されている場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 대기 중인 로컬 메시지를 제거합니다. 컴퓨터에서는 계속 수신하거나 처리할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el mensaje pendiente local. El equipo aún podría recibirlo o procesarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci supprime le message local en attente. L’ordinateur pourrait tout de même le recevoir ou le traiter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающее сообщение будет удалено локально. Компьютер всё равно может получить или обработать его."
          }
        }
      }
    },
