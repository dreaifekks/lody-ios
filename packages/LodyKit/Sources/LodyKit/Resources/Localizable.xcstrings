    "home.onboarding.commandHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the installer on a macOS/Linux server, VM, or computer. Node.js is included. It prints a sign-in link you can open on this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS/Linux 服务器、虚拟机或电脑上运行安装脚本，已包含 Node.js。安装时会显示登录链接，可以在手机上打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS/Linux 伺服器、虛擬機或電腦上執行安裝程式（已內含 Node.js）。執行後會顯示登入連結，可直接在手機上開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS または Linux のサーバー、VM、コンピューターでインストーラーを実行してください（Node.js 同梱）。このスマートフォンで開けるサインインリンクが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 또는 Linux 서버, VM, 컴퓨터에서 설치 프로그램을 실행하세요. Node.js가 포함되어 있으며, 이 휴대폰에서 열 수 있는 로그인 링크가 표시됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta el instalador en un servidor, máquina virtual o equipo con macOS/Linux. Incluye Node.js. Mostrará un enlace de inicio de sesión que puedes abrir en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez l’installateur sur un serveur, une VM ou un ordinateur macOS/Linux. Node.js est inclus. Il affiche un lien de connexion à ouvrir sur ce téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите установщик на сервере, виртуальной машине или компьютере с macOS/Linux. Node.js уже включён. Он выведет ссылку для входа, которую можно открыть на этом телефоне."
          }
        }
      }
    },
