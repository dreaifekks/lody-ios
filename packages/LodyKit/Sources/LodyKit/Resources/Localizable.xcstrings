          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트하면 게시된 사본이 현재 대화 기록과 제목으로 교체됩니다. 링크는 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al actualizar se reemplaza la copia publicada con el historial y el título actuales. El enlace sigue siendo el mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour remplace la copie publiée par l’historique et le titre actuels. Le lien reste identique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При обновлении опубликованная копия заменяется текущей историей и заголовком. Ссылка остаётся прежней."
          }
        }
      }
    },
