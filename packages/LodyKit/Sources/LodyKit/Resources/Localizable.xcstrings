    "auth.error.signOutIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出未完全完成，请重试；本机凭据是否清除以当前登录状态为准"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-out did not finish. Try again; the current sign-in state shows whether local credentials were cleared."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出尚未完成，請再試一次；目前的登入狀態會顯示本機憑證是否已清除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトが完了しませんでした。もう一度お試しください。ローカルの認証情報が消去されたかどうかは、現在のサインイン状態に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃이 완료되지 않았습니다. 다시 시도하세요. 로컬 인증 정보가 삭제되었는지는 현재 로그인 상태에서 확인할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el cierre de sesión. Inténtalo de nuevo; el estado actual de inicio de sesión indica si se borraron las credenciales locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion ne s’est pas terminée. Réessayez ; l’état de connexion actuel indique si les identifiants locaux ont été effacés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход не завершён. Попробуйте снова; текущий статус входа показывает, очищены ли локальные учётные данные."
          }
        }
      }
    },
    "auth.toast.accountSaveFailed": {
