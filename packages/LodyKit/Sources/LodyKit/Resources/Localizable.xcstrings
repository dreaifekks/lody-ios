    "send.error.shortcut": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证此模板。请刷新 Prompt Shortcuts，或移除命令后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut could not be verified. Refresh Prompt Shortcuts or remove its command and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證此捷徑。請重新整理「提示詞捷徑」，或移除其指令後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットを確認できませんでした。プロンプトショートカットを更新するか、コマンドを削除してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축어를 확인할 수 없습니다. 프롬프트 단축어를 새로고침하거나 해당 명령어를 제거한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar este atajo. Actualiza los atajos de prompts o quita su comando e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci n’a pas pu être vérifié. Actualisez les raccourcis de prompt ou supprimez sa commande et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить эту быструю команду. Обновите быстрые команды или удалите её из сообщения и повторите попытку."
          }
        }
      }
    },
