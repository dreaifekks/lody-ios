        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "額度來自此主機的訂閱方案，而非工作區帳單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用枠はワークスペースの課金ではなく、このマシンのサブスクリプションに基づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할당량은 워크스페이스 결제가 아닌 이 머신의 구독 기준입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuotas corresponden a las suscripciones de este equipo, no a la facturación del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quotas correspondent aux abonnements de cette machine, et non à la facturation de l’espace de travail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квоты относятся к подпискам этой машины, а не к биллингу рабочего пространства."
          }
        }
      }
    },
