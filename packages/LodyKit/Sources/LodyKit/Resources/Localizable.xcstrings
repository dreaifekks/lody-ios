          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待目标机器的恢复服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待目標電腦的復原服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象マシンのリカバリサービスを待機しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 컴퓨터의 복구 서비스를 기다리는 중입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al servicio de recuperación del equipo de destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du service de récupération de la machine cible."
          }
