    "create.machineConfig.ready": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个模型会记住推理强度和权限模式；首次选择时优先使用完全访问权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each model remembers your effort and mode selections. New selections use full access when available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個模型都會記住你的推理強度與權限模式設定；初次選擇時會優先套用完整存取權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各モデルは思考レベルとモードの選択を記憶します。新しい選択では、利用可能な場合フルアクセスが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 모델은 선택한 추론 강도와 모드를 기억합니다. 새로 선택하면 가능한 경우 전체 접근 권한을 사용합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modelo recuerda tus selecciones de esfuerzo y modo. Las nuevas selecciones usan acceso completo cuando está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modèle mémorise vos choix d’effort et de mode. Les nouvelles sélections utilisent l’accès complet lorsqu’il est disponible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая модель запоминает выбранные усилия и режим. Для новых настроек по возможности используется полный доступ."
          }
        }
      }
    },
