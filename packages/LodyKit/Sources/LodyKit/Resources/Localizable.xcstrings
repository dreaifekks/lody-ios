        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 생성되지 않았습니다. 메시지는 복원되었으며, 컴퓨터 설정을 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se creó la sesión. Se restauró tu mensaje; comprueba la configuración del equipo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session n’a pas été créée. Votre message a été restauré ; vérifiez la configuration de l’ordinateur et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия не создана. Ваше сообщение восстановлено; проверьте настройки компьютера и попробуйте ещё раз."
          }
        }
      }
    },
