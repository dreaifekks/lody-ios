            "value": "找不到符合的專案或工作階段。內容搜尋僅限此裝置上開啟過的對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するプロジェクトやセッションがありません。本文検索の対象はこのデバイスで開いた会話のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 프로젝트나 세션이 없습니다. 내용 검색은 이 기기에서 연 대화만 포함합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay proyectos ni sesiones coincidentes. La búsqueda de contenido solo abarca conversaciones abiertas en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet ni session correspondant. La recherche dans le contenu ne couvre que les conversations ouvertes sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящих проектов и сессий не найдено. Поиск по содержимому охватывает только диалоги, открытые на этом устройстве."
          }
        }
      }
    },
