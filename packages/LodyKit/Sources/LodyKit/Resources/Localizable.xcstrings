        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行時將使用此對話的 Agent 與工作區，請於網頁版編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットのエージェントとワークスペースで実行されます。Webで編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 시 이 채팅의 에이전트와 워크스페이스를 사용합니다. 웹에서 편집할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ejecuciones usan el agente y el espacio de trabajo de este chat. Edítalo en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exécutions utilisent l’agent et l’espace de travail de cette discussion. Modifiez-la sur le web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При запуске используются агент и рабочая область этого чата. Редактирование доступно в веб-версии."
          }
        }
      }
    },
    "schedules.destination.ownSessionPendingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created on the first run; every later run continues it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次运行时创建，之后每次运行都接着这个对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
