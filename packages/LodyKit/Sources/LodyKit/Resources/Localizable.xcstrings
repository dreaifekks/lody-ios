    "diagnostics.exportHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择涵盖问题发生时间的范围。分享文件时，请说明当时的操作和大致时间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a range that covers when it happened. When you share the file, say what you were doing and the approximate time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇涵蓋問題發生時段的範圍。分享檔案時，請一併說明當時的操作與大致時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生した時間帯を含む期間を選択してください。ファイルを共有する際は、行っていた操作とおおよその時刻を添えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생한 시점이 포함된 범위를 선택하세요. 파일을 공유할 때 당시 하던 작업과 대략적인 시간을 함께 알려주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un intervalo que cubra cuándo ocurrió. Al compartir el archivo, indica qué estabas haciendo y la hora aproximada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une période qui couvre le moment de l’incident. Lorsque vous partagez le fichier, indiquez ce que vous faisiez et l’heure approximative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите период, охватывающий момент сбоя. Отправляя файл, опишите, что вы делали, и укажите примерное время."
          }
        }
      }
    },
