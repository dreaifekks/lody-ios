    "settings.shortcuts.empty": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可访问的模板，可以创建私有或工作区模板。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accessible shortcuts. Add a private or workspace shortcut."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可存取的捷徑。請新增私人或工作區捷徑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なショートカットがありません。プライベートまたはワークスペースのショートカットを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 가능한 단축어가 없습니다. 비공개 또는 워크스페이스 단축어를 추가해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay atajos accesibles. Agrega un atajo privado o del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci accessible. Ajoutez un raccourci privé ou d’espace de travail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступных быстрых команд. Добавьте личную команду или команду для рабочего пространства."
          }
        }
      }
    },
    "settings.shortcuts.changed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板已变更或访问权限已撤销，请刷新后重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut changed or access was revoked. Refresh and reopen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捷徑已變更或存取權限已被撤銷，請重新整理後再開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットが変更されたか、アクセス権が取り消されました。更新してから開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어가 변경되었거나 접근 권한이 취소되었습니다. 새로고침한 후 다시 열어 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atajo cambió o se revocó el acceso. Actualiza y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccourci a été modifié ou l’accès a été révoqué. Actualisez et rouvrez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда изменилась или доступ был отозван. Обновите список и откройте её снова."
          }
        }
      }
    },
    "settings.shortcuts.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法确认保存结果。草稿已保留，请重试本次保存，或取消并刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save could not be confirmed. Your draft is retained; retry this same save or cancel and refresh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是否已儲存。草稿已保留，請重試這次儲存，或取消並重新整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存を確認できませんでした。下書きは保持されているため、このまま再試行するか、キャンセルして更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장을 확인할 수 없습니다. 초안은 그대로 유지되니 같은 내용으로 다시 저장하거나 취소 후 새로고침하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el guardado. Se conserva tu borrador; vuelve a intentar este mismo guardado o cancela y actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’a pas pu être confirmé. Votre brouillon est conservé ; réessayez cet enregistrement ou annulez et actualisez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить сохранение. Черновик сохранён: повторите это же сохранение или отмените и обновите."
          }
        }
      }
    },
    "settings.shortcuts.readonly": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅所有者可编辑。带上下文或结构化提及的模板在 iOS 上仅供查看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the owner can edit. Templates with context or structured references are view only on iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅擁有者可以編輯。包含上下文或結構化參照的範本在 iOS 上僅供檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集できるのはオーナーのみです。コンテキストや構造化参照を含むテンプレートは、iOSでは閲覧のみとなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소유자만 편집할 수 있습니다. 컨텍스트나 구조화된 참조가 포함된 템플릿은 iOS에서 보기 전용입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario puede editar. Las plantillas con contexto o referencias estructuradas son de solo lectura en iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire peut modifier. Les modèles avec contexte ou références structurées sont en lecture seule sur iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактировать может только владелец. Шаблоны с контекстом или структурированными ссылками на iOS доступны только для просмотра."
          }
        }
      }
    },
    "settings.shortcuts.slug": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
