    "settings.roostHistoryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversations use Roost when the selected machine supports it. Existing conversations keep their current history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话在所选电脑支持时使用 Roost；已有会话保留原有历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當所選電腦支援時，新對話會使用 Roost；現有對話將保留目前的歷史紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したマシンが対応している場合、新しい会話ではRoostが使用されます。既存の会話では現在の履歴が保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 머신이 Roost를 지원하는 경우 새 대화에 Roost가 사용됩니다. 기존 대화는 현재 기록을 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones nuevas usan Roost cuando la máquina seleccionada lo admite. Las conversaciones existentes conservan su historial actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles conversations utilisent Roost lorsque la machine sélectionnée le prend en charge. Les conversations existantes conservent leur historique actuel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые переписки используют Roost, если выбранная машина его поддерживает. В существующих переписках сохраняется текущая история."
          }
        }
      }
    },
