    "chat.empty.prompt": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想继续做些什么？\n消息会与电脑同步，随时接着聊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to do next?\nMessages sync with your computer, so you can pick up any time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來想做些什麼？\n訊息會與電腦保持同步，隨時都能接續進行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次は何をしますか？\nメッセージはコンピュータと同期されるため、いつでも続きから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에는 무엇을 해볼까요?\n메시지가 컴퓨터와 동기화되므로 언제든 이어서 작업할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te gustaría hacer ahora?\nLos mensajes se sincronizan con tu computadora, así que puedes retomar en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous faire ensuite ?\nLes messages se synchronisent avec votre ordinateur, vous pouvez donc reprendre à tout moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем займёмся дальше?\nСообщения синхронизируются с компьютером, так что вы можете продолжить в любой момент."
          }
        }
      }
    },
