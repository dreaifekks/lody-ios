    "schedules.error.schedule_message_read_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled messages can only be deleted here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时消息在这里只能删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排程訊息在此處僅供刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールされたメッセージは、ここでは削除のみ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 메시지는 여기에서 삭제만 할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes programados solo se pueden eliminar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages planifiés ne peuvent être supprimés qu’ici."
