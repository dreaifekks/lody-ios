    "schedules.error.schedule_not_owner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the schedule owner can change it, on a computer they own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有定时任务的所有者可以在自己的机器上修改它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有排程擁有者可以在自己擁有的電腦上修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを変更できるのは、自身が所有するコンピューター上のスケジュールオーナーのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 소유자만 본인이 소유한 컴퓨터에서 이 예약을 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario de la programación puede modificarla, desde un equipo suyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire de la planification peut la modifier, sur un ordinateur qui lui appartient."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменять расписание может только его владелец на принадлежащем ему компьютере."
          }
        }
      }
    },
    "schedules.error.schedule_machine_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the target machine’s CLI to edit schedules."
          }
        },
        "zh-Hans": {
