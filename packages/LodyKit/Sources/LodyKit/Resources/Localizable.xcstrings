        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine is offline. Connect it to add or refresh providers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器已离线。连接后可添加或刷新提供方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此主機目前離線。請先連線，再新增或重新整理提供者。"
