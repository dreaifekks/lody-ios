    "send.error.workspacePaymentRequired": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成工作区设置，再创建会话或发送消息。草稿已保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish setting up this workspace before creating or sending sessions. Your draft is saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先完成此工作區的設定，再建立工作階段或傳送訊息。草稿已儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを作成または送信する前に、このワークスペースの設定を完了してください。下書きは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 만들거나 메시지를 보내기 전에 이 워크스페이스 설정을 완료해 주세요. 초안은 저장되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina de configurar este espacio de trabajo antes de crear o enviar sesiones. Tu borrador está guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la configuration de cet espace de travail avant de créer ou d’envoyer des sessions. Votre brouillon est enregistré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите настройку этого рабочего пространства перед созданием или отправкой сессий. Ваш черновик сохранён."
          }
        }
      }
    },
    "send.error.mentions": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析这条消息中的引用。草稿已保存，可点击消息下方的“重试”重新解析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your draft is saved. Tap Retry below the message to resolve its references again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已儲存。請點一下訊息下方的「重試」，重新解析其中的參照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きは保存されています。メッセージの下にある「再試行」をタップして参照を解決し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안이 저장되었습니다. 참조를 다시 확인하려면 메시지 아래의 다시 시도를 탭하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu borrador está guardado. Toca Reintentar debajo del mensaje para volver a resolver sus referencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre brouillon est enregistré. Touchez Réessayer sous le message pour résoudre ses références à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновик сохранён. Нажмите «Повторить» под сообщением, чтобы снова разрешить ссылки."
          }
        }
      }
    },
    "send.error.draftSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保存待发送内容，消息尚未发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the pending message, so nothing was sent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存待傳送的訊息，因此未進行傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信待ちのメッセージを保存できなかったため、何も送信されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 메시지를 저장할 수 없어 전송되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el mensaje pendiente, por lo que no se envió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le message en attente, rien n’a donc été envoyé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить отложенное сообщение, поэтому ничего не отправлено."
          }
        }
      }
    },
