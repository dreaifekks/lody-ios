            "state": "translated",
            "value": "更新将用当前历史和标题替换已发布副本，链接保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating replaces the published copy with the current history and title. The link stays the same."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新後將以目前的對話紀錄與標題取代已發布的副本，連結會保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
