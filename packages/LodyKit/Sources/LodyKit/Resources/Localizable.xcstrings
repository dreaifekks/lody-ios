    "settings.github.repositoryHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启的仓库可供工作区功能使用。仅工作区所有者和管理员可以修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace features can use the repositories that are on. Only workspace owners and admins can change this."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟的儲存庫可供工作區功能使用。僅工作區擁有者與管理員可以變更此設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンになっているリポジトリをワークスペース機能で利用できます。変更できるのはワークスペースのオーナーと管理者のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있는 저장소를 워크스페이스 기능에서 사용할 수 있습니다. 워크스페이스 소유자와 관리자만 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones del espacio de trabajo pueden usar los repositorios activados. Solo propietarios y administradores pueden cambiar esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités de l’espace de travail peuvent utiliser les dépôts activés. Seuls les propriétaires et administrateurs peuvent modifier ceci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции рабочего пространства могут использовать включённые репозитории. Менять это могут только владельцы и администраторы."
          }
        }
      }
    },
    "settings.github.readonly": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅工作区所有者和管理员可以修改仓库访问范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only workspace owners and admins can change repository access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅工作區擁有者與管理員可以變更儲存庫存取權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリへのアクセス権を変更できるのは、ワークスペースのオーナーと管理者のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 소유자와 관리자만 저장소 접근 권한을 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los propietarios y administradores del espacio de trabajo pueden cambiar el acceso a los repositorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les propriétaires et administrateurs de l’espace de travail peuvent modifier l’accès aux dépôts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Менять доступ к репозиториям могут только владельцы и администраторы рабочего пространства."
          }
        }
      }
    },
    "settings.github.roleUnknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证管理权限，仓库修改已停用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions could not be verified. Repository changes are disabled."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證權限，已停用儲存庫變更功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限を確認できなかったため、リポジトリの変更は無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한을 확인할 수 없어 저장소 변경이 비활성화되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar los permisos. Los cambios en repositorios están desactivados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les autorisations. Les modifications des dépôts sont désactivées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить права. Изменение репозиториев отключено."
          }
        }
      }
    },
