    "auth.reset.sent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists for this email, a reset link has been sent. Complete the reset on the website, then return here to sign in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此邮箱对应账户，重置链接已发送。请在网站完成重置，然后返回此处登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若此電子郵件對應已有帳號，我們已寄出重設連結。請在網站上完成重設，再返回此處登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスのアカウントが存在する場合、リセット用リンクを送信しました。Webサイトでリセットを完了してから、ここに戻ってサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이메일로 등록된 계정이 있다면 재설정 링크가 전송되었습니다. 웹사이트에서 재설정을 완료한 뒤 이 화면으로 돌아와 로그인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta para este correo, se ha enviado un enlace de restablecimiento. Completa el proceso en el sitio web y luego vuelve aquí para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe pour cette adresse e-mail, un lien de réinitialisation a été envoyé. Terminez la réinitialisation sur le site web, puis revenez ici pour vous connecter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если для этого адреса существует аккаунт, ссылка для сброса отправлена. Завершите сброс пароля на сайте, а затем вернитесь сюда для входа."
          }
        }
      }
    },
    "auth.reset.unsupportedLocal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password reset is not supported for local or nonproduction backends. No reset email was requested."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地或非生产后端不支持重置密码。未请求发送重置邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機或非正式環境後端不支援重設密碼，未發出重設郵件請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルまたは非本番バックエンドではパスワードリセットがサポートされていません。リセットメールは送信されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 또는 비운영 백엔드에서는 비밀번호 재설정이 지원되지 않습니다. 재설정 이메일이 요청되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El restablecimiento de contraseña no es compatible con backends locales o que no son de producción. No se solicitó ningún correo de restablecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réinitialisation du mot de passe n'est pas prise en charge pour les backends locaux ou hors production. Aucun e-mail de réinitialisation n'a été demandé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сброс пароля не поддерживается для локальных или тестовых серверов. Письмо для сброса не запрашивалось."
          }
        }
      }
    },
    "auth.reset.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to send the reset email. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送重置邮件，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法傳送重設郵件，請再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットメールを送信できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설정 이메일을 보내지 못했습니다. 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el correo de restablecimiento. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer l'e-mail de réinitialisation. Veuillez réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить письмо для сброса пароля. Попробуйте ещё раз."
          }
        }
      }
    },
    "debug.native.ui.verification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI verification"
