        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 무료 워크스페이스의 세션 수가 최대치인 200개에 도달하여 새 탭을 만들지 못했습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo gratuito alcanzó las 200 sesiones, por lo que no se creó ninguna pestaña nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
