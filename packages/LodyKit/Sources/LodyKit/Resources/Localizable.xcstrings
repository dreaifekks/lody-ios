    "home.onboarding.nextStep.chat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to start your first task: pick this computer and a project, or no project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点 + 新建对话，选这台机器和项目（也可以不选项目），下发第一个任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 開始第一個任務：選擇這台電腦與專案（也可不選專案）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「+」をタップして最初のタスクを開始します。このコンピューターとプロジェクトを選択するか、プロジェクトなしで開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+를 탭하여 첫 번째 작업을 시작하세요. 이 컴퓨터와 프로젝트를 선택하거나, 프로젝트 없이 시작할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para iniciar tu primera tarea: elige este equipo y un proyecto, o ningún proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour lancer votre première tâche : choisissez cet ordinateur et un projet, ou aucun projet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы запустить первую задачу: выберите этот компьютер и проект или начните без проекта."
          }
        }
      }
    },
