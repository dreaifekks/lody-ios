    "settings.providers.argsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one argument per line. Arguments are passed directly to the command."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行输入一个参数。参数将直接传递给命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行輸入一個參數。參數會直接傳遞給指令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行につき1つの引数を入力してください。引数はコマンドに直接渡されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나의 인수를 입력하세요. 인수는 명령어에 직접 전달됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa un argumento por línea. Los argumentos se pasan directamente al comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un argument par ligne. Les arguments sont transmis directement à la commande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите по одному аргументу на строку. Они передаются команде напрямую."
          }
        }
      }
    },
    "settings.providers.setupHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected machine prepares the provider. You can follow its setup progress on the provider list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选机器将准备提供方。你可以在提供方列表查看配置进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選主機將會準備此提供者。你可以在提供者列表中查看設定進度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したマシンでプロバイダーを準備します。セットアップの進行状況はプロバイダー一覧で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기기에서 프로바이더를 준비합니다. 프로바이더 목록에서 설정 진행 상태를 확인할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo seleccionado prepara el proveedor. Puedes seguir el progreso de la configuración en la lista de proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine sélectionnée prépare le fournisseur. Vous pouvez suivre sa configuration dans la liste des fournisseurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная машина подготавливает провайдера. Ход настройки можно отслеживать в списке провайдеров."
          }
        }
      }
    },
    "settings.providers.writeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be confirmed. Refresh the provider list before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认更改结果。请刷新提供方列表后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認變更是否成功。請先重新整理提供者列表再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を確認できませんでした。プロバイダー一覧を更新してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 확인할 수 없습니다. 프로바이더 목록을 새로 고친 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio. Actualiza la lista de proveedores antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas pu être confirmée. Actualisez la liste des fournisseurs avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить изменение. Обновите список провайдеров перед повторной попыткой."
          }
        }
      }
    },
    "settings.providers.scopeChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or workspace changed. Close this page and open the provider again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户或工作区已更改。请关闭此页后重新打开提供方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號或工作區已變更。請關閉此頁面後重新開啟提供者。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントまたはワークスペースが変更されました。このページを閉じてプロバイダーをもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 또는 워크스페이스가 변경되었습니다. 이 페이지를 닫고 프로바이더를 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta o el espacio de trabajo cambió. Cierra esta página y vuelve a abrir el proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte ou l’espace de travail a changé. Fermez cette page et rouvrez le fournisseur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт или рабочая область изменились. Закройте эту страницу и откройте провайдера снова."
          }
        }
      }
    },
    "settings.providers.authRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to this provider on its machine, then refresh its capabilities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在提供方所在机器登录，然后刷新能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在該主機上登入此提供者，再重新整理功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のマシンでこのプロバイダーにサインインしてから、機能を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기기에서 이 프로바이더에 로그인한 후 기능을 새로 고치세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en este proveedor en su equipo y luego actualiza sus capacidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à ce fournisseur sur sa machine, puis actualisez ses capacités."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в этот провайдер на его машине, затем обновите его возможности."
          }
        }
      }
    },
