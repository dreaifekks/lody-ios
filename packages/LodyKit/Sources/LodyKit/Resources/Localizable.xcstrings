        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框中用 @ 提及角色，即可與它開始對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄で @ を使ってロールをメンションすると、そのロールでチャットを開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력창에서 @로 역할을 멘션해 대화를 시작해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menciona un rol con @ en el editor para iniciar un chat con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentionnez un rôle avec @ dans le champ de saisie pour démarrer une discussion avec lui."
