    "projects.github.noRepositories": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lody GitHub App can't reach any repositories yet. Grant it access on GitHub, then come back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lody GitHub App 还不能访问任何仓库。请先在 GitHub 上授权，再回来添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lody GitHub App 尚未取得任何儲存庫的存取權限。請先前往 GitHub 授權後再返回新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lody GitHub Appからまだリポジトリにアクセスできません。GitHub上でアクセス権を付与してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lody GitHub App이 아직 어떤 저장소에도 접근할 수 없습니다. GitHub에서 접근 권한을 부여한 후 돌아오세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La GitHub App de Lody aún no tiene acceso a ningún repositorio. Otórgale acceso en GitHub y luego regresa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application GitHub Lody n’a encore accès à aucun dépôt. Accordez-lui l’accès sur GitHub, puis revenez ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение Lody GitHub App пока не имеет доступа ни к одному репозиторию. Предоставьте ему доступ на GitHub и вернитесь сюда."
          }
        }
      }
    },
    "projects.github.noRepositoriesMember": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No repositories are connected yet. Ask a workspace admin to install the Lody GitHub App."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有连接任何仓库。请让工作区管理员安装 Lody GitHub App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未連結任何儲存庫。請聯絡工作區管理員安裝 Lody GitHub App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだリポジトリが接続されていません。ワークスペースの管理者にLody GitHub Appのインストールを依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 연결된 저장소가 없습니다. 워크스페이스 관리자에게 Lody GitHub App 설치를 요청하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay repositorios conectados. Pide a un administrador del espacio de trabajo que instale la GitHub App de Lody."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dépôt n’est encore connecté. Demandez à un administrateur de l’espace de travail d’installer l’application GitHub Lody."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозитории ещё не подключены. Попросите администратора рабочего пространства установить приложение Lody GitHub App."
          }
        }
      }
    },
    "projects.github.memberNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only workspace admins and owners can add repositories."
