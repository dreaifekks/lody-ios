    "settings.github.personalHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的身份创建 PR、评论和合并，而不是使用工作区 GitHub App。授权或续期请在 Lody 网页端完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act as you for PRs, comments, and merges instead of the workspace GitHub App. Authorize or renew in Lody web."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的身分執行 PR、留言與合併，而非透過工作區 GitHub App。請前往 Lody 網頁版進行授權或續期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのGitHub Appではなく、あなたのアカウントとしてPRの作成・コメント・マージを行います。承認や更新はLody Webで行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 GitHub App 대신 본인 계정으로 PR, 댓글, 병합을 수행합니다. Lody 웹에서 인증하거나 갱신하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actúa en tu nombre en PRs, comentarios y fusiones en lugar de la GitHub App del espacio de trabajo. Autoriza o renueva en Lody web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agir en votre nom pour les PR, les commentaires et les fusions au lieu de la GitHub App de l’espace de travail. Autorisez ou renouvelez dans Lody web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнять PR, комментарии и слияния от вашего имени вместо GitHub App рабочего пространства. Авторизуйтесь или обновите доступ в веб-версии Lody."
          }
        }
      }
    },
