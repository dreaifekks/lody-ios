    "pr.investigatePrompt": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请排查这个 PR 的 CI 检查问题，先说明失败原因和建议修复："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Investigate the CI check issues for this PR. First explain the failures and proposed fixes:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請調查此 PR 的 CI 檢查問題，先說明失敗原因與建議的修正方式："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この PR の CI チェックの問題を調査してください。まず失敗の内容と修正案を説明してください:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PR의 CI 체크 문제를 조사하세요. 먼저 실패 원인과 제안하는 수정 사항을 설명해 주세요:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Investiga los problemas de las comprobaciones de CI de este PR. Primero explica los fallos y las soluciones propuestas:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez les problèmes de vérification CI de cette PR. Expliquez d’abord les échecs et les correctifs proposés :"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучите проблемы с проверками CI для этого PR. Сначала объясните причины сбоев и предложите исправления:"
          }
        }
      }
    },
    "pr.draftAdded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排查请求已追加到会话草稿。返回会话后可以编辑并发送，原有文字和附件会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The investigation request was appended to your session draft. Return to the conversation to edit and send. Existing text and attachments are preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將調查請求加入對話草稿。返回對話即可編輯並傳送，原有的文字與附件皆會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調査リクエストをセッションの下書きに追記しました。会話に戻って編集し、送信してください。既存のテキストと添付ファイルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조사 요청이 세션 초안에 추가되었습니다. 대화로 돌아가 수정한 후 전송하세요. 기존 텍스트와 첨부 파일은 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de investigación se agregó al borrador de tu sesión. Vuelve a la conversación para editarla y enviarla. Se conservan el texto y los archivos adjuntos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande d’analyse a été ajoutée au brouillon de votre session. Revenez à la conversation pour la modifier et l’envoyer. Le texte et les pièces jointes existants sont conservés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на разбор добавлен в черновик сессии. Вернитесь в диалог, чтобы отредактировать и отправить его. Существующий текст и вложения сохранены."
          }
        }
      }
    },
