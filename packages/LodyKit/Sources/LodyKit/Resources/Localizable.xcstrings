{
  "sourceLanguage": "en",
  "strings": {
    "settings.github.authorizeInWeb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lody web"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Lody 网页端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Lody 網頁版"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lody Webを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lody 웹 열기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Lody web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Lody Web"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть веб-версию Lody"
          }
        }
      }
    },
    "settings.github.authorizationHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Lody web with the same Lody account and authorize or renew your personal GitHub access. Then return here and retry connecting the GitHub App. Your “Act as you” preference does not need to be enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Lody 网页端登录同一个 Lody 账号，授权或续期个人 GitHub 访问权限，然后返回此处重试连接 GitHub App。无需开启“以你的身份操作”偏好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用相同的 Lody 帳號登入 Lody 網頁版，授權或更新個人 GitHub 存取權限，然後返回此處重新連結 GitHub App。無需開啟「以您的身分操作」偏好設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じLodyアカウントでLody Webにサインインし、個人のGitHubアクセスを認可または更新してください。その後ここに戻り、GitHub Appの接続をもう一度お試しください。「自分として操作」設定を有効にする必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 Lody 계정으로 Lody 웹에 로그인해 개인 GitHub 접근 권한을 승인하거나 갱신하세요. 그런 다음 여기로 돌아와 GitHub App 연결을 다시 시도하세요. “내 계정으로 실행” 설정은 켜지 않아도 됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Lody web con la misma cuenta de Lody y autoriza o renueva tu acceso personal a GitHub. Luego vuelve aquí y vuelve a intentar conectar la GitHub App. No es necesario que la preferencia «Actuar como tú» esté activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Lody Web avec le même compte Lody et autorisez ou renouvelez votre accès GitHub personnel. Revenez ensuite ici et réessayez de connecter l’app GitHub. Votre préférence « Agir en votre nom » n’a pas besoin d’être activée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в веб-версию Lody под тем же аккаунтом Lody и предоставьте или обновите персональный доступ к GitHub. Затем вернитесь сюда и повторите подключение GitHub App. Включать параметр «Действовать от вашего имени» не обязательно."
          }
        }
      }
    },
    "settings.github.authorizationRequired": {
      "extractionState": "manual",
      "localizations": {
