          }
        }
      }
    },
    "schedules.error.schedule_prompt_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what the Agent should do (up to 32 KB)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写需要 Agent 执行的任务内容（不超过 32 KB）。"
