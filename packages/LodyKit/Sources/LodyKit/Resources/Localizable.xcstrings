    "auth.login.verificationBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is a new email account, we sent a verification link to %@.\nIf you previously used Google, GitHub, Apple, or Discord with this email, sign in with that provider or set a password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这是新的邮箱账号，我们已向 %@ 发送验证链接。\n如果你之前用 Google、GitHub、Apple 或 Discord 登录过这个邮箱，请继续使用对应平台登录，或先设置密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若這是新建立的電子郵件帳號，我們已將驗證連結寄送至 %@。\n若你先前曾使用 Google、GitHub、Apple 或 Discord 透過此電子郵件登入，請改用該服務登入，或先設定密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメールアカウントの場合、%@ 宛に確認用リンクを送信しました。\n以前このメールアドレスでGoogle、GitHub、Apple、またはDiscordをご利用になったことがある場合は、該当サービスでサインインするか、パスワードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이메일 계정인 경우 %@ 주소로 인증 링크를 보냈습니다.\n이전에 이 이메일로 Google, GitHub, Apple 또는 Discord를 사용하신 적이 있다면 해당 계정으로 로그인하거나 비밀번호를 설정해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta es una cuenta de correo nueva, enviamos un enlace de verificación a %@.\nSi ya usaste Google, GitHub, Apple o Discord con este correo, inicia sesión con ese proveedor o establece una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il s'agit d'un nouveau compte par e-mail, un lien de vérification a été envoyé à %@.\nSi vous avez déjà utilisé Google, GitHub, Apple ou Discord avec cette adresse, connectez-vous via ce fournisseur ou définissez un mot de passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это новый аккаунт с email, мы отправили ссылку для подтверждения на %@.\nЕсли вы ранее использовали Google, GitHub, Apple или Discord с этим адресом, войдите через соответствующий сервис или задайте пароль."
          }
        }
      }
    },
