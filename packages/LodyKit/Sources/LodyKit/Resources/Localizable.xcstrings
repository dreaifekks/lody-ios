    "pr.error.commentUnknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认评论是否已发布。草稿已保留，请先在 GitHub 核对，避免重复发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm whether the comment was posted. Your draft is retained. Check GitHub before sending again to avoid duplicates."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認留言是否已發布。您的草稿已保留，再次傳送前請先前往 GitHub 確認，以免重複發布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメントが投稿されたか確認できませんでした。下書きは保持されています。重複を防ぐため、再送信する前に GitHub を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "댓글이 등록되었는지 확인할 수 없습니다. 작성 중인 내용은 유지됩니다. 중복 등록을 방지하려면 다시 보내기 전에 GitHub에서 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar si se publicó el comentario. Tu borrador se conserva. Revisa GitHub antes de volver a enviarlo para evitar duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer la publication du commentaire. Votre brouillon est conservé. Vérifiez GitHub avant de renvoyer pour éviter les doublons."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить публикацию комментария. Черновик сохранён. Проверьте GitHub перед повторной отправкой, чтобы избежать дубликатов."
          }
        }
      }
    },
