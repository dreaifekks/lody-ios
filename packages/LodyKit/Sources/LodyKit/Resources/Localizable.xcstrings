    "settings.remote.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取远程设置，请检查连接后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load remote settings. Check your connection and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入遠端設定，請檢查連線後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート設定を読み込めませんでした。接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 설정을 불러올 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los ajustes remotos. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les réglages à distance. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить удалённые настройки. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
    "settings.remote.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是否保存成功，编辑内容已保留。请重新打开此设置检查远端值后再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the save. Your edits are still here. Reopen this setting to check the remote value before trying again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是否儲存成功，您的編輯內容仍已保留。請重新開啟此設定以確認遠端值後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存を確認できませんでした。編集内容は保持されています。もう一度試す前に、この設定を開き直してリモートの値を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 여부를 확인할 수 없습니다. 편집한 내용은 그대로 남아 있습니다. 다시 시도하기 전에 이 설정을 다시 열어 원격 값을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el guardado. Tus cambios siguen aquí. Vuelve a abrir este ajuste para verificar el valor remoto antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer l’enregistrement. Vos modifications sont toujours là. Rouvrez ce réglage pour vérifier la valeur distante avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить сохранение. Ваши изменения сохранены локально. Откройте настройку заново, чтобы проверить удалённое значение перед повторной попыткой."
          }
        }
      }
    },
    "settings.remote.conflict": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设置已被其他客户端修改。请复制编辑内容后重新打开，读取最新值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting changed on another client. Copy your edits, then reopen it to load the latest value."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定已在其他用戶端變更。請先複製您的編輯內容，再重新開啟以載入最新值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は別のクライアントで変更されました。編集内容をコピーしてから開き直し、最新の値を読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정이 다른 클라이언트에서 변경되었습니다. 편집한 내용을 복사한 다음 다시 열어 최신 값을 불러오세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste cambió en otro cliente. Copia tus cambios y vuelve a abrirlo para cargar el valor más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage a été modifié sur un autre client. Copiez vos modifications, puis rouvrez-le pour charger la dernière valeur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта настройка была изменена на другом клиенте. Скопируйте свои правки, затем откройте её снова, чтобы загрузить актуальное значение."
          }
        }
      }
    },
