    "pr.deleteBranch.message": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除 GitHub 上的分支 %@ 吗？之后仍可在 GitHub 的 Pull Request 页面恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@ on GitHub? You can restore it from the pull request page on GitHub."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除 GitHub 上的分支 %@ 嗎？之後仍可在 GitHub 的 Pull Request 頁面還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上の %@ を削除しますか？GitHub のプルリクエストページから復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 %@ 브랜치를 삭제할까요? GitHub의 Pull Request 페이지에서 복구할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ en GitHub? Puedes restaurarla desde la página de la pull request en GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ sur GitHub ? Vous pourrez la restaurer depuis la page de la pull request sur GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ на GitHub? Вы сможете восстановить её со страницы пул-реквеста на GitHub."
          }
        }
      }
    },
