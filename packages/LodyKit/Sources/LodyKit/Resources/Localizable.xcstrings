        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過手機傳送新對話回合，並回覆權限要求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンから新しいターンを送信し、許可リクエストに応答できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
