    "diagnostics.retention": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在这台 iPhone 上保存，最多保留 7 天、总容量 5 MB。存储空间达到上限时，会提前移除旧事件。不会自动上传。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this iPhone for up to 7 days, up to 5 MB. Older events may be removed earlier when storage is full. Nothing is uploaded on its own."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存在這台 iPhone 上，最多保留 7 天、總容量上限 5 MB。儲存空間不足時，較早的事件可能會提前移除。系統不會自動上傳任何資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに最大7日間・最大5 MB保存されます。容量が上限に達した場合、古いイベントから先に削除されることがあります。データが自動的にアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 최대 7일, 최대 5MB까지 보관됩니다. 저장 공간이 가득 차면 오래된 이벤트가 먼저 삭제될 수 있으며, 자동으로 업로드되지는 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este iPhone hasta 7 días y hasta 5 MB. Los eventos más antiguos pueden eliminarse antes si se llena el almacenamiento. No se sube nada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservés sur cet iPhone jusqu’à 7 jours, dans la limite de 5 Mo. Les événements plus anciens peuvent être supprimés plus tôt si le stockage est plein. Rien n’est envoyé automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится на этом iPhone до 7 дней (до 5 МБ). При заполнении хранилища старые события могут удаляться раньше. Ничего не отправляется автоматически."
          }
        }
      }
    },
