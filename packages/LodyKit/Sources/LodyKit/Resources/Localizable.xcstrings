        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트와 시간을 선택하세요. 실행할 때마다 컴퓨터에서 새 채팅을 시작합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una instrucción y una hora. Tu equipo iniciará un nuevo chat en cada ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un prompt et une heure. Votre machine démarrera une nouvelle discussion à chaque exécution."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите промпт и время. Ваш компьютер будет запускать новый чат для каждого выполнения."
          }
        }
      }
