    "workspace.e2ee.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile does not yet support end-to-end encrypted workspaces. Please open this workspace in Lody Desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动端暂不支持端到端加密工作区，请使用 Lody 桌面端打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行動版尚未支援端對端加密工作區，請使用 Lody 桌面版開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイル版はまだエンドツーエンド暗号化ワークスペースに対応していません。Lody デスクトップ版でこのワークスペースを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일에서는 아직 종단 간 암호화 워크스페이스를 지원하지 않습니다. Lody 데스크톱에서 이 워크스페이스를 열어 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app móvil aún no admite espacios de trabajo cifrados de extremo a extremo. Abre este espacio de trabajo en Lody Desktop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app mobile ne prend pas encore en charge les espaces de travail chiffrés de bout en bout. Ouvrez cet espace de travail dans Lody Desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мобильное приложение пока не поддерживает рабочие пространства со сквозным шифрованием. Откройте это рабочее пространство в Lody Desktop."
          }
        }
      }
    },
