    "schedules.trigger.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs only when you press Run. Keep the prompt and target ready for whenever you need it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你点击“运行”时执行。把提示词和目标准备好，随时可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在按下「執行」時觸發，先備妥提示詞與目標，隨時可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「実行」を押したときだけ実行されます。必要なときにいつでも使えるよう、プロンプトと実行先を準備しておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행을 누를 때만 작동합니다. 필요할 때 바로 쓸 수 있도록 프롬프트와 대상을 준비해 두세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta solo cuando presionas Ejecutar. Ten listos la instrucción y el destino para cuando los necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne s’exécute que lorsque vous appuyez sur Exécuter. Gardez le prompt et la cible prêts dès que vous en avez besoin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускается только по нажатию кнопки запуска. Промпт и цель всегда под рукой."
          }
        }
      }
    },
