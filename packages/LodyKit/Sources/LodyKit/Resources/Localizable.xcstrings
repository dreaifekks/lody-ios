    "settings.roles.hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色是创建会话的预设，可在输入框中通过 @ 引用。不可用的目标不能被引用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roles are presets for creating sessions. Reference a role with @ in the composer. Unavailable targets cannot be referenced."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "角色是用於建立工作階段的預設設定，可在輸入框中透過 @ 引用。無法使用的目標將無法引用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロールはセッション作成用のプリセットです。入力欄で「@」を使ってロールを参照できます。利用できないターゲットは参照できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역할은 세션을 만들 때 사용하는 프리셋입니다. 입력창에서 @를 입력해 역할을 참조하세요. 사용할 수 없는 대상은 참조할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los roles son ajustes preestablecidos para crear sesiones. Menciona un rol con @ en el editor. Los destinos no disponibles no se pueden mencionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rôles sont des préréglages pour créer des sessions. Mentionnez un rôle avec @ dans la zone de saisie. Les cibles indisponibles ne peuvent pas être mentionnées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роли — это пресеты для создания сессий. Упомяните роль через @ в поле ввода. Недоступные цели указать нельзя."
          }
        }
      }
    },
    "settings.roles.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅所有者可以编辑或删除此角色。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the owner can edit or delete this role."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅擁有者可以編輯或刪除此角色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このロールを編集・削除できるのはオーナーのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소유자만 이 역할을 편집하거나 삭제할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario puede editar o eliminar este rol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire peut modifier ou supprimer ce rôle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только владелец может изменять или удалять эту роль."
          }
        }
      }
    },
    "settings.roles.configurationHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新角色使用 Agent 默认配置。已有目标、模型、运行选项和记忆关联会保留，编辑这些配置请使用电脑端。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New roles use Agent defaults. Existing targets, models, run options and memory are preserved. Edit these on your computer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新角色會使用 Agent 預設設定。現有的目標、模型、執行選項與記憶關聯將會保留。請在電腦上編輯這些設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいロールにはエージェントのデフォルト設定が使われます。既存のターゲット、モデル、実行オプション、メモリは保持されます。これらはコンピューターで編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 역할에는 에이전트 기본값이 적용됩니다. 기존 대상, 모델, 실행 옵션 및 메모리는 유지됩니다. 이 항목들은 컴퓨터에서 편집하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los roles nuevos usan los valores predeterminados del Agente. Se conservan los destinos, modelos, opciones de ejecución y memoria existentes. Edítalos en tu computadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux rôles utilisent les réglages par défaut de l’Agent. Les cibles, modèles, options d’exécution et la mémoire existants sont conservés. Modifiez-les sur votre ordinateur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые роли используют настройки Агента по умолчанию. Существующие цели, модели, параметры запуска и память сохраняются. Измените их на компьютере."
          }
        }
      }
    },
    "settings.roles.visibilityHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私有仅限制客户端展示，不隔离工作区存储。请勿在角色指令中填写秘密。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private limits discovery in clients, not workspace storage. Never put secrets in role instructions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設為「私人」僅限制用戶端的探索可見性，不會隔離工作區儲存空間。請勿在角色指令中放入機密資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開にするとクライアント上での表示は制限されますが、ワークスペースのストレージ自体は制限されません。ロールの指示に機密情報を記載しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 설정은 워크스페이스 저장소가 아니라 클라이언트에서의 검색만 제한합니다. 역할 지침에 비밀 정보를 절대 입력하지 마세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado limita la visibilidad en los clientes, no en el almacenamiento del espacio de trabajo. Nunca incluyas secretos en las instrucciones del rol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’option Privé limite la visibilité dans les clients, pas le stockage de l’espace de travail. Ne mettez jamais de secrets dans les instructions d’un rôle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватность скрывает роль в клиентах, но не в хранилище рабочего пространства. Никогда не добавляйте секреты в инструкции роли."
          }
        }
      }
    },
    "settings.roles.effectHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过角色引用创建会话时使用。编辑角色不会改变已接受的执行配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when creating a session through a role reference. Editing a role does not change an already accepted run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過角色引用建立工作階段時使用。編輯角色不會變更已接受的執行設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロール参照からセッションを作成するときに使用されます。ロールを編集しても、すでに受け付けられた実行には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역할 참조를 통해 세션을 만들 때 사용됩니다. 역할을 편집해도 이미 수락된 실행에는 영향을 주지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa al crear una sesión mediante la mención de un rol. Editar un rol no modifica una ejecución ya aceptada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lors de la création d’une session via une mention de rôle. La modification d’un rôle n’affecte pas une exécution déjà acceptée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при создании сессии по упоминанию роли. Изменение роли не влияет на уже принятый запуск."
          }
        }
      }
    },
    "settings.roles.delete": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除角色"
          }
