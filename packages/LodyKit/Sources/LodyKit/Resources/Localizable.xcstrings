    "settings.providers.sorbetCapabilityMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Lody on this computer to manage Sorbet connections. Native encrypted settings transport is also required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新此电脑上的 Lody 以管理 Sorbet 连接，同时需要原生加密设置传输支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
