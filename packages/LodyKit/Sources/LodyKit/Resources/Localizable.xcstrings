    "send.recover.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether the original message was saved and hand it to the computer. Removing it locally does not cancel processing on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对原消息是否已保存，再交给电脑处理。本地移除不会取消电脑上的处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查原訊息是否已儲存，並交由電腦處理。從本機移除不會取消電腦上的處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のメッセージが保存されているか確認し、コンピューターに引き渡します。ローカルで削除しても、コンピューター上の処理はキャンセルされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 메시지가 저장되었는지 확인하고 컴퓨터에 전달합니다. 이 기기에서 삭제해도 컴퓨터에서 진행 중인 작업은 취소되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si el mensaje original se guardó y entrégalo al equipo. Eliminarlo localmente no cancela el procesamiento en el equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si le message d’origine a été enregistré et transmettez-le à l’ordinateur. Le supprimer localement n’annule pas son traitement sur l’ordinateur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, сохранилось ли исходное сообщение, и передайте его компьютеру. Удаление на устройстве не отменяет обработку на компьютере."
          }
        }
      }
    },
    "send.recover.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm delivery. The message is still pending; check the connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法确认交接，消息仍待确认。请检查连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認送達，訊息仍處於等待確認狀態。請檢查連線後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信を確認できませんでした。メッセージは保留中です。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송을 확인할 수 없습니다. 메시지가 아직 대기 중입니다. 연결 상태를 확인한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la entrega. El mensaje sigue pendiente; comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer l’envoi. Le message est toujours en attente ; vérifiez la connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить доставку. Сообщение ещё ожидает отправки; проверьте подключение и повторите попытку."
          }
        }
      }
    },
