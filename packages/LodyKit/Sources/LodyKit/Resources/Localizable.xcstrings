    "session.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除失败。请检查连接并确认会话已停止，然后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete. Check your connection and make sure the session has stopped, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除。請檢查網路連線並確認工作階段已停止，然後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できませんでした。接続を確認し、セッションが停止していることを確認してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하지 못했습니다. 연결 상태를 확인하고 세션이 중지되었는지 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar. Comprueba tu conexión y asegúrate de que la sesión se haya detenido, luego inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer la session. Vérifiez votre connexion, assurez-vous qu’elle est bien arrêtée, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
