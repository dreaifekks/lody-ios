    "schedules.deleteHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future runs stop and the schedule is removed. Chats it already started are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后不会再运行，任务将被删除。已经创建的对话会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後將不再執行並移除此排程，先前建立的對話仍會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の実行が停止され、スケジュールが削除されます。すでに開始されたチャットは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 실행이 중지되고 예약이 삭제됩니다. 이미 시작된 채팅은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detendrán las ejecuciones futuras y se eliminará la programación. Los chats ya iniciados se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exécutions futures s’arrêteront et la planification sera supprimée. Les discussions déjà démarrées sont conservées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будущие запуски остановятся, а расписание будет удалено. Уже начатые чаты сохранятся."
          }
        }
      }
    },
    "schedules.deleteMessageHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is removed from this list. Anything already sent stays in the chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条消息会从列表移除，已发送的内容仍保留在对话里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此訊息將從列表中移除，已傳送的內容仍會保留在對話中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージはこの一覧から削除されます。すでに送信済みのものはチャットに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록에서 메시지가 삭제됩니다. 이미 전송된 내용은 채팅에 그대로 남습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje se eliminará de esta lista. Todo lo que ya se haya enviado permanecerá en el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est retiré de cette liste. Tout ce qui a déjà été envoyé reste dans la discussion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение удалится из этого списка. Всё, что уже отправлено, останется в чате."
          }
        }
      }
    },
