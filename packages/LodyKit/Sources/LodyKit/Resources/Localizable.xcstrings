    "message.fork.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue from this reply in a new tab, using the same project and working directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这条回复开始，在新标签中继续对话，沿用当前项目和工作目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從這則回覆開始，在新分頁中沿用相同專案與工作目錄繼續對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じプロジェクトと作業ディレクトリのまま、この返信から新しいタブで会話を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 프로젝트와 작업 디렉터리를 사용하여 새 탭에서 이 답변부터 대화를 이어갑니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa desde esta respuesta en una nueva pestaña, usando el mismo proyecto y directorio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poursuivez à partir de cette réponse dans un nouvel onglet, avec le même projet et le même répertoire de travail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить с этого ответа в новой вкладке, используя тот же проект и рабочий каталог."
          }
        }
      }
    },
    "message.action.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message cannot be used for this action. Refresh the conversation and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前消息暂不支持此操作，请刷新对话后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此訊息無法執行這項操作，請重新整理對話後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージではこの操作を実行できません。会話を更新してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지에는 해당 작업을 사용할 수 없습니다. 대화를 새로 고친 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar este mensaje para esta acción. Actualiza la conversación e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message ne peut pas être utilisé pour cette action. Actualisez la conversation et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сообщение нельзя использовать для данного действия. Обновите диалог и попробуйте ещё раз."
          }
        }
      }
    },
    "message.action.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is not yet confirmed. Check the conversation before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作结果尚未确认，请先检查对话，避免重复提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作結果尚未確認，請先查看對話再重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果がまだ確定していません。会話を確認してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 아직 확인되지 않았습니다. 다시 시도하기 전에 대화를 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado aún no está confirmado. Revisa la conversación antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat n'est pas encore confirmé. Vérifiez la conversation avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат ещё не подтверждён. Проверьте диалог перед повторной попыткой."
          }
        }
      }
    },
