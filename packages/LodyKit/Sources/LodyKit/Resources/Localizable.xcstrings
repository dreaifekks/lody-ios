    "message.details.explanation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计本轮用量。输入不含缓存，输出包含推理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage for this turn only. Input excludes cache; output includes reasoning."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅統計本輪用量。輸入不含快取，輸出包含推理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターン単体の使用量です。入力にキャッシュは含まれず、出力には推論が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 턴의 사용량만 표시됩니다. 입력에는 캐시가 제외되며, 출력에는 추론이 포함됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso solo de este turno. La entrada excluye la caché; la salida incluye el razonamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation pour ce tour uniquement. L’entrée exclut le cache ; la sortie inclut le raisonnement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход только за этот ответ. Входящие не включают кеш; исходящие включают рассуждение."
          }
        }
      }
    },
