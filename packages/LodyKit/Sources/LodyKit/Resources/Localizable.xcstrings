      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从这台电脑读取引用，请检查连接后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load references from this computer. Check the connection and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從此電腦載入引用項目，請檢查連線後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピューターから参照を読み込めませんでした。接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에서 참조를 불러올 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las referencias de este equipo. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les références depuis cet ordinateur. Vérifiez la connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить ссылки с этого компьютера. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
