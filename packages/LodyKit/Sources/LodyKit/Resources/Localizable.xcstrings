    "session.tabs.freeSessionLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Free workspace has reached 200 sessions, so no new Tab was created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此免费工作区已达到 200 个会话上限，未创建新 Tab。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此免費工作區已達 200 個對話上限，無法建立新 Tab。"
          }
