    "native.chat.warning.stopRequestFailedGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent could not process the Stop request. Lody will keep trying to end the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 未能处理停止请求，Lody 会继续尝试结束当前任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 無法處理停止請求，Lody 將繼續嘗試結束此任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが停止リクエストを処理できませんでした。Lody はタスクの終了を引き続き試みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 중지 요청을 처리하지 못했습니다. Lody가 계속해서 작업 종료를 시도합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente no pudo procesar la solicitud para detener. Lody seguirá intentando finalizar la tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent n’a pas pu traiter la demande d’arrêt. Lody va continuer d’essayer de terminer la tâche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенту не удалось обработать запрос на остановку. Lody продолжит попытки завершить задачу."
          }
        }
      }
    },
    "native.chat.warning.stopTimedOutGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task has not stopped yet. Lody is trying to force it to end."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务尚未停止，Lody 正在尝试强制结束它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務尚未停止，Lody 正在嘗試強制結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはまだ停止していません。Lody は強制終了を試みています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 아직 중지되지 않았습니다. Lody가 강제 종료를 시도하고 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea aún no se ha detenido. Lody está intentando forzar su finalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche ne s’est pas encore arrêtée. Lody tente de forcer son arrêt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача ещё не остановилась. Lody пытается завершить её принудительно."
          }
        }
      }
    },
    "native.chat.warning.stopTerminationFailedGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task may still be running. Try restarting Lody’s background service on this machine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务可能仍在运行。请尝试重启这台机器上的 Lody 后台服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務可能仍在執行中。請嘗試重新啟動這台電腦上的 Lody 背景服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクがまだ実行中の可能性があります。このマシン上の Lody バックグラウンドサービスを再起動してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 아직 실행 중일 수 있습니다. 이 컴퓨터에서 Lody 백그라운드 서비스를 다시 시작해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la tarea siga ejecutándose. Prueba reiniciar el servicio en segundo plano de Lody en este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche est peut-être encore en cours d’exécution. Essayez de redémarrer le service en arrière-plan de Lody sur cette machine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача всё ещё может выполняться. Попробуйте перезапустить фоновую службу Lody на этом компьютере."
          }
        }
      }
    },
    "native.chat.warning.nativeWorkInterruptedGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent stopped before its background tasks finished, so their results may be missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 在后台任务完成前就停止了，这些任务的结果可能缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 在背景任務完成前即已停止，因此可能缺少部分執行結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドタスクの完了前にエージェントが停止したため、結果の一部が欠落している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 작업이 완료되기 전에 에이전트가 중지되어 일부 결과가 누락되었을 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente se detuvo antes de que terminaran sus tareas en segundo plano, por lo que pueden faltar sus resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent s’est arrêté avant la fin de ses tâches en arrière-plan ; leurs résultats peuvent donc être manquants."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент остановился до завершения фоновых задач, поэтому их результаты могут отсутствовать."
          }
        }
      }
    },
