    "home.onboarding.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents run on a computer you own — this app is mission control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 实际运行在你的电脑上，手机端用来随时随地下达和跟进任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 實際在你的電腦上執行，這個 App 則是你的指揮中心。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはお手持ちのコンピューター上で動作します。このアプリはそのコントロールセンターです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 내 컴퓨터에서 실행되며, 이 앱은 원격 제어실 역할을 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes se ejecutan en un equipo tuyo; esta app es el centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents s’exécutent sur un ordinateur qui vous appartient — cette app est votre centre de contrôle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты работают на вашем компьютере — это приложение служит центром управления."
          }
        }
      }
    },
