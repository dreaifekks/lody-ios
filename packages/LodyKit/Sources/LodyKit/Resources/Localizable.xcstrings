    "settings.github.browserHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 中添加仓库或调整访问范围。完成后返回此页下拉刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens GitHub to add repositories or change access. Come back and pull down to refresh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將開啟 GitHub 以新增儲存庫或變更存取權限。完成後請返回此頁面並下拉重新整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリの追加やアクセス権の変更のためGitHubを開きます。戻ったら下に引いて更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소를 추가하거나 접근 권한을 변경하려면 GitHub가 열립니다. 완료 후 앱으로 돌아와 아래로 당겨 새로고침하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre GitHub para agregar repositorios o cambiar el acceso. Vuelve y desliza hacia abajo para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre GitHub pour ajouter des dépôts ou modifier l’accès. Revenez et tirez vers le bas pour actualiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется GitHub для добавления репозиториев или изменения доступа. Вернитесь и потяните вниз для обновления."
          }
        }
      }
    },
