    "chat.edit.notice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新发送将替换这条消息及其回复，并停止当前回复。已经产生的文件改动会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resending replaces this message and its replies. Any current reply will stop. Changes already made to files are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新傳送將會取代這則訊息及其回覆，並停止目前的回覆。已對檔案做的變更將會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再送信すると、このメッセージとその返信が置き換わります。生成中の返信は停止します。すでにファイルに加えた変更はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 보내면 이 메시지와 그에 대한 답장이 대체됩니다. 현재 진행 중인 응답은 중단되며, 파일에 이미 적용된 변경 사항은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reenviar, se reemplazarán este mensaje y sus respuestas. Cualquier respuesta en curso se detendrá. Los cambios ya realizados en los archivos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renvoi remplace ce message et ses réponses. Toute réponse en cours sera arrêtée. Les modifications déjà apportées aux fichiers sont conservées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторная отправка заменит это сообщение и ответы на него. Текущий ответ будет остановлен. Внесённые в файлы изменения сохранятся."
          }
        }
      }
    },
    "chat.edit.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法编辑这条消息，请检查连接后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to open this message for editing. Check your connection and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟此訊息進行編輯，請檢查網路連線後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージを編集用に開けませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지를 수정할 수 없습니다. 네트워크 연결을 확인하고 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir este mensaje para editarlo. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ce message pour le modifier. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть сообщение для редактирования. Проверьте подключение и попробуйте снова."
          }
        }
      }
    },
    "chat.edit.failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能替换消息，编辑内容已保留。请检查连接，并确认它仍是最后一条可编辑消息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message could not be replaced. Your edits are kept. Check the connection and whether this is still the last editable message."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取代此訊息，您的編輯內容已保留。請檢查連線狀態，並確認這是否仍為最後一則可編輯的訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを置き換えられませんでした。編集内容は保持されています。接続状況と、このメッセージが編集可能な最後のメッセージであるかをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 대체하지 못했습니다. 수정한 내용은 유지됩니다. 연결 상태와 이 메시지가 여전히 수정 가능한 마지막 메시지인지 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reemplazar el mensaje. Se conservan tus cambios. Comprueba la conexión y verifica si sigue siendo el último mensaje editable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas pu être remplacé. Vos modifications sont conservées. Vérifiez la connexion et s’il s’agit toujours du dernier message modifiable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось заменить сообщение. Правки сохранены. Проверьте подключение и убедитесь, что это всё ещё последнее доступное для редактирования сообщение."
          }
        }
      }
    },
    "chat.edit.unknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认重新发送的结果。编辑内容已保留，请先检查状态，避免重复发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend has not been confirmed. Your edits are kept; check its status before sending again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未確認重新傳送的結果。您的編輯內容已保留；再次傳送前請先檢查狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再送信を確認できませんでした。編集内容は保持されています。もう一度送信する前に状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재전송 여부가 확인되지 않았습니다. 수정한 내용은 유지되니, 다시 보내기 전에 상태를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha confirmado el reenvío. Se conservan tus cambios; comprueba su estado antes de volver a enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renvoi n’a pas été confirmé. Vos modifications sont conservées ; vérifiez son statut avant de renvoyer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторная отправка не подтверждена. Правки сохранены; проверьте статус перед новой отправкой."
          }
        }
      }
    },
