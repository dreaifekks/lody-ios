    "settings.providers.envWriteOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved values are never shown. Keep leaves a value unchanged; Replace writes a new value; Remove deletes it when you save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会显示已保存的值。“保留”不改变已有值；“替换”写入新值；“移除”在保存时删除该变量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的值不會顯示。「保留」會維持原有值不變；「取代」會寫入新值；「移除」會在儲存時刪除此變數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された値は表示されません。「保持」では値は変更されず、「置換」では新しい値が書き込まれ、「削除」では保存時に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 값은 표시되지 않습니다. 유지는 기존 값을 변경하지 않고, 교체는 새 값을 저장하며, 제거는 저장 시 해당 변수를 삭제합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores guardados nunca se muestran. Conservar deja un valor sin cambios; Reemplazar escribe un valor nuevo; Quitar lo elimina al guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs enregistrées ne sont jamais affichées. Conserver laisse la valeur inchangée ; Remplacer écrit une nouvelle valeur ; Supprimer l’efface lors de l’enregistrement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые значения никогда не отображаются. «Оставить» оставляет значение без изменений, «Заменить» записывает новое, а «Удалить» стирает его при сохранении."
          }
        }
      }
    },
    "settings.providers.envKeep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
