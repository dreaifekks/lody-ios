    "session.tabs.swipeClose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑关闭对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左滑動即可關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左にスワイプして閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽으로 쓸어넘겨 닫기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia la izquierda para cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers la gauche pour fermer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните влево, чтобы закрыть"
          }
        }
      }
    },
    "session.tabs.allClosed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No open Tab. Tap the conversations button to create or restore a conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无打开的 Tab，点击右上角对话按钮新建或恢复对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開啟的 Tab。點選對話按鈕即可新增或還原對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているタブがありません。会話ボタンをタップして会話を作成または復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 탭이 없습니다. 대화 버튼을 탭하여 새 대화를 만들거나 기존 대화를 복원하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna pestaña abierta. Toca el botón de conversaciones para crear o restaurar una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun onglet ouvert. Touchez le bouton des conversations pour créer ou restaurer une conversation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет открытых вкладок. Нажмите кнопку диалогов, чтобы создать или восстановить диалог."
          }
        }
      }
    },
    "session.tabs.changeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the change. Check the Tab list before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认操作结果，请检查 Tab 列表后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認變更結果，請先查看 Tab 清單再重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を確認できませんでした。タブ一覧を確認してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 확인하지 못했습니다. 다시 시도하기 전에 탭 목록을 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio. Revisa la lista de pestañas antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer la modification. Vérifiez la liste des onglets avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить изменение. Проверьте список вкладок перед повторной попыткой."
          }
        }
      }
    },
    "native.attachment.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attachment upload was cancelled. The message has not been sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件上传已取消，消息尚未发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消上傳附件，訊息尚未傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのアップロードがキャンセルされました。メッセージは送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일 업로드가 취소되어 메시지가 전송되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la subida del archivo adjunto. El mensaje no se ha enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi de la pièce jointe a été annulé. Le message n'a pas été envoyé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка вложения отменена. Сообщение не отправлено."
          }
        }
      }
    },
    "native.attachment.error.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not establish the attachment upload connection. Check your network; export diagnostics if it keeps failing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法建立附件上传连接，请检查网络后重试；持续失败时请导出诊断日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立附件上傳連線，請檢查網路；若持續失敗，請匯出診斷記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのアップロード接続を確立できませんでした。ネットワークを確認してください。繰り返し失敗する場合は診断情報をエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일 업로드 연결을 설정하지 못했습니다. 네트워크를 확인하고, 문제가 계속되면 진단 정보를 내보내 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer la conexión para subir el archivo adjunto. Comprueba tu red y exporta los diagnósticos si el error persiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'établir la connexion pour l'envoi de la pièce jointe. Vérifiez votre réseau et exportez les diagnostics si le problème persiste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить соединение для загрузки вложения. Проверьте сеть; если ошибка повторяется, экспортируйте диагностику."
          }
        }
      }
    },
    "native.attachment.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network is unavailable or the connection was lost during upload. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传时网络连接不可用或已中断，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳期間網路無法使用或連線中斷，請檢查連線後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが利用できないか、アップロード中に接続が切断されました。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크를 사용할 수 없거나 업로드 중 연결이 끊어졌습니다. 연결 상태를 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red no está disponible o se perdió la conexión durante la subida. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau est indisponible ou la connexion a été perdue pendant l'envoi. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть недоступна или соединение прервалось во время загрузки. Проверьте подключение и попробуйте ещё раз."
          }
        }
      }
    },
    "native.attachment.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many upload requests. Wait a moment and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传请求过于频繁，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳請求過於頻繁，請稍候再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードのリクエストが多すぎます。しばらく待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 요청이 너무 많습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes de subida. Espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes d'envoi. Patientez un instant et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов на загрузку. Подождите немного и попробуйте ещё раз."
          }
        }
      }
    },
    "native.attachment.error.storageQuota": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or workspace attachment storage quota is exhausted. Free up space or contact an administrator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户或工作区的附件存储配额已用完，请释放空间或联系管理员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號或工作區的附件儲存空間配額已滿，請釋出空間或聯絡管理員。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントまたはワークスペースの添付ファイル容量が上限に達しています。空き容量を増やすか、管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 또는 워크스페이스의 첨부 파일 저장 공간 한도에 도달했습니다. 공간을 확보하거나 관리자에게 문의해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó la cuota de almacenamiento de archivos adjuntos de la cuenta o del espacio de trabajo. Libera espacio o contacta con un administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota de stockage des pièces jointes du compte ou de l'espace de travail est épuisé. Libérez de l'espace ou contactez un administrateur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квота хранилища вложений аккаунта или рабочего пространства исчерпана. Освободите место или обратитесь к администратору."
          }
        }
      }
    },
    "native.attachment.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attachment upload timed out. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件上传超时，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件上傳逾時，請檢查連線後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのアップロードがタイムアウトしました。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일 업로드 시간이 초과되었습니다. 연결 상태를 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera para subir el archivo adjunto. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi de la pièce jointe a expiré. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превышено время ожидания загрузки вложения. Проверьте подключение и попробуйте ещё раз."
          }
        }
      }
    },
    "native.attachment.error.uploadFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This attachment format is not supported by the upload service. Convert it or attach it as a file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传接口不支持此附件格式，请转换格式或作为文件重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳服務不支援此附件格式，請轉換格式或改以檔案形式附加。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この添付形式はアップロードサービスでサポートされていません。形式を変換するか、ファイルとして添付してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 서비스에서 지원하지 않는 첨부 파일 형식입니다. 형식을 변환하거나 파일로 첨부해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de subida no admite este formato de archivo adjunto. Conviértelo o adjúntalo como archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format de pièce jointe n'est pas pris en charge par le service d'envoi. Convertissez-la ou joignez-la en tant que fichier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат вложения не поддерживается сервисом загрузки. Конвертируйте его или прикрепите как файл."
          }
        }
      }
    },
    "native.attachment.error.uploadInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload request was rejected as invalid. Select the attachment again; if it still fails, try a new conversation and export diagnostics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传请求未通过校验，请重新选择附件后重试；仍失败时请尝试新对话并导出诊断日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳請求無效而遭到拒絕，請重新選取附件；若仍失敗，請開新對話並匯出診斷記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なリクエストとしてアップロードが拒否されました。添付ファイルを選択し直してください。それでも失敗する場合は、新しい会話で試すか診断情報をエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 업로드 요청으로 거부되었습니다. 첨부 파일을 다시 선택해 보고, 계속 실패하면 새 대화에서 시도한 뒤 진단 정보를 내보내 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de subida fue rechazada por no ser válida. Vuelve a seleccionar el archivo adjunto; si sigue fallando, prueba en una nueva conversación y exporta los diagnósticos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande d'envoi a été rejetée car elle est invalide. Sélectionnez à nouveau la pièce jointe ; si l'échec persiste, essayez dans une nouvelle conversation et exportez les diagnostics."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на загрузку отклонён как некорректный. Выберите вложение заново; если ошибка сохранится, начните новый диалог и экспортируйте диагностику."
          }
        }
      }
    },
    "native.attachment.error.uploadService": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attachment upload service is temporarily unavailable. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件上传服务暂时异常，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件上傳服務暫時無法使用，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのアップロードサービスは一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일 업로드 서비스를 일시적으로 사용할 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de subida de archivos adjuntos no está disponible temporalmente. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'envoi de pièces jointes est temporairement indisponible. Réessayez plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис загрузки вложений временно недоступен. Попробуйте позже."
          }
        }
      }
    },
    "native.attachment.error.uploadTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attachment exceeds the upload size limit. Reduce its size and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件超过上传大小限制，请缩小或压缩后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件超過上傳大小上限，請縮小檔案後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルがアップロードサイズの上限を超えています。サイズを小さくしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일이 업로드 크기 제한을 초과했습니다. 크기를 줄인 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo adjunto supera el límite de tamaño permitido. Reduce su tamaño e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce jointe dépasse la taille maximale autorisée. Réduisez sa taille et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер вложения превышает допустимый лимит. Уменьшите его и попробуйте ещё раз."
          }
        }
      }
    },
    "native.attachment.error.uploadUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload destination is unavailable. Check access to the conversation and workspace, or try a new conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传目标不可用，请确认对话和工作区仍可访问，或新建对话后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳目標無法使用，請確認對話與工作區的存取權限，或開新對話再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード先が利用できません。会話とワークスペースへのアクセス権限を確認するか、新しい会話をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 대상에 연결할 수 없습니다. 대화 및 워크스페이스 접근 권한을 확인하거나 새 대화에서 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino de subida no está disponible. Comprueba el acceso a la conversación y al espacio de trabajo, o prueba en una nueva conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination d'envoi est indisponible. Vérifiez l'accès à la conversation et à l'espace de travail, ou essayez dans une nouvelle conversation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место назначения для загрузки недоступно. Проверьте доступ к диалогу и рабочему пространству или начните новый диалог."
          }
        }
      }
    },
    "native.attachment.error.uploadSignIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload authentication failed. Sign in again and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传身份验证失败，请重新登录后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳驗證失敗，請重新登入後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードの認証に失敗しました。再度サインインしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 인증에 실패했습니다. 다시 로그인한 후 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de autenticación al subir el archivo. Vuelve a iniciar sesión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification pour l'envoi a échoué. Reconnectez-vous et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка аутентификации при загрузке. Войдите в аккаунт заново и повторите попытку."
          }
        }
      }
    },
    "native.attachment.error.uploadPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to upload attachments to this workspace or conversation. Contact an administrator to check access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有向此工作区或对话上传附件的权限，请联系管理员确认访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你沒有權限將附件上傳至此工作區或對話，請聯絡管理員確認存取權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースまたは会話に添付ファイルをアップロードする権限がありません。アクセス権について管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워크스페이스 또는 대화에 첨부 파일을 업로드할 권한이 없습니다. 관리자에게 접근 권한 확인을 요청해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para subir archivos adjuntos a este espacio de trabajo o conversación. Contacta con un administrador para revisar tu acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas l'autorisation d'envoyer des pièces jointes dans cet espace de travail ou cette conversation. Contactez un administrateur pour vérifier vos accès."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас нет прав на загрузку вложений в это рабочее пространство или диалог. Обратитесь к администратору для проверки доступа."
          }
        }
      }
    },
    "auth.native.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to connect. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線，請檢查網路後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません。通信環境を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결할 수 없습니다. 네트워크 상태를 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться. Проверьте соединение и попробуйте ещё раз."
          }
        }
      }
    },
    "auth.native.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to sign in. Check your credentials and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法登录，请检查登录信息后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法登入，請檢查登入資訊後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインできません。認証情報を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 수 없습니다. 로그인 정보를 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión. Comprueba tus credenciales e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Vérifiez vos identifiants et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти. Проверьте учётные данные и попробуйте ещё раз."
          }
        }
      }
    },
    "auth.native.googleConfiguration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google sign-in is not configured for this build. Contact support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未配置 Google 登录，请联系支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未設定 Google 登入，請聯絡客服支援。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではGoogleサインインが設定されていません。サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 Google 로그인이 설정되어 있지 않습니다. 지원팀에 문의해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con Google no está configurado para esta compilación. Contacta con soporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Google n'est pas configurée pour cette version. Contactez l'assistance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход через Google не настроен для этой сборки. Обратитесь в поддержку."
          }
        }
      }
    },
    "auth.reset.title": {
      "localizations": {
