    "bar.prompt.prBranchUpkeep": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 创建后，在本对话的每轮结束时把改动提交并推送到 PR 分支。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the PR exists, commit and push your changes to the PR branch at the end of every turn in this conversation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 建立後，請在此對話的每一輪結束時，將變更提交並推送到 PR 分支。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PRの作成後は、この会話の毎ターン終了時に変更をPRブランチへコミット＆プッシュしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PR이 생성된 후에는 이 대화의 매 턴이 끝날 때마다 변경 사항을 커밋하여 PR 브랜치에 푸시하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que exista el PR, haz commit y push de tus cambios a la rama del PR al final de cada turno en esta conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la PR créée, commitez et poussez vos modifications sur la branche de la PR à la fin de chaque tour de cette conversation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После создания PR коммитьте и отправляйте изменения в ветку PR в конце каждого хода в этой беседе."
          }
        }
      }
    },
    "bar.prompt.commitAndPush": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交未提交的改动，并推送当前分支。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit the uncommitted changes and push the current branch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交尚未提交的變更，並推送目前的分支。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未コミットの変更をコミットして、現在のブランチをプッシュしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋되지 않은 변경 사항을 커밋하고 현재 브랜치를 푸시하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz commit de los cambios sin confirmar y haz push de la rama actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commiter les modifications non commitées et pousser la branche actuelle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закоммитьте незакоммиченные изменения и отправьте текущую ветку."
          }
        }
      }
    },
    "bar.prompt.resolveConflicts": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解决 %1$@ PR %2$@ 的合并冲突：%3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the merge conflicts of %1$@ pull request %2$@: %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解決 %1$@ PR %2$@ 的合併衝突：%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のプルリクエスト %2$@ のマージコンフリクトを解消してください: %3$@"
