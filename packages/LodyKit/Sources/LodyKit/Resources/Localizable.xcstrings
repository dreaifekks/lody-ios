    "onboarding.reply.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上发送新一轮消息，处理权限请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send new turns and answer permission requests from your phone."
