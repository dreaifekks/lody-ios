          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve los conflictos de fusión del pull request %2$@ de %1$@: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résoudre les conflits de fusion de la pull request %2$@ de %1$@ : %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устраните конфликты слияния в pull request %2$@ репозитория %1$@: %3$@"
          }
        }
      }
    },
