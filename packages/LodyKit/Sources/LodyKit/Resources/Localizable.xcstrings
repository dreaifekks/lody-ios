          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить роль"
          }
        }
      }
    },
    "settings.roles.deleteHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除“%1$@”？后续将无法引用它，已有会话保留已接受的配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%1$@”? Future references will be unavailable. Existing sessions will keep their accepted configuration."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除「%1$@」嗎？刪除後將無法再引用此角色，現有工作階段仍會保留已接受的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を削除しますか？今後このロールは参照できなくなります。既存のセッションでは、すでに適用された設定がそのまま維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” 역할을 삭제할까요? 앞으로는 참조할 수 없게 됩니다. 기존 세션은 수락된 구성을 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%1$@”? Las menciones futuras no estarán disponibles. Las sesiones existentes conservarán su configuración aceptada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %1$@ » ? Les futures mentions seront indisponibles. Les sessions existantes conserveront leur configuration acceptée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@»? Новые упоминания станут недоступны. Существующие сессии сохранят принятую конфигурацию."
          }
        }
      },
      "comment": "1: name"
    },
    "settings.roles.unknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认修改结果，请关闭表单并刷新，核对状态后再尝试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be confirmed. Close this form and refresh before trying again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認變更結果。請關閉此表單並重新整理後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を確認できませんでした。この画面を閉じて更新してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 확인할 수 없습니다. 이 양식을 닫고 새로고침한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio. Cierra este formulario y actualiza antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas pu être confirmée. Fermez ce formulaire et actualisez avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить изменение. Закройте эту форму и обновите данные перед повторной попыткой."
          }
        }
      }
    },
    "settings.roles.invalid": {
