	<array/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Lody</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>0.111.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lody</string>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
				<string>$(LODY_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LodyAppGroup</key>
	<string>$(LODY_APP_GROUP)</string>
	<key>GIDClientID</key>
	<string>$(LODY_GOOGLE_IOS_CLIENT_ID)</string>
	<key>GIDServerClientID</key>
	<string>$(LODY_GOOGLE_SERVER_CLIENT_ID)</string>
	<key>LodyOneSignalAppId</key>
	<string>930dcd5c-3534-46aa-805d-f279f008f80b</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- iOS 17+ applies ATS to IP literals. Tailnet traffic is encrypted by WireGuard. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Take photos to attach to your messages.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your Lody LAN hub and its machines on the local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate messages. Your voice is turned into text on this device, and the recording is not saved or uploaded.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images from your conversations to Photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos to attach to your messages.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you dictate into message text. Recognition runs on this device.</string>
	<key>OneSignal_app_groups_key</key>
	<string>$(LODY_APP_GROUP)</string>
	<key>OneSignal_suppress_launch_urls</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
